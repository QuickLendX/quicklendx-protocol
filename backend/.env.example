# Copy this file to .env and fill in values for local development.
# Never commit .env — it is in .gitignore.
# All variables validated at startup are defined in src/config.ts.

# ── Server ────────────────────────────────────────────────────────────────────
# Runtime environment: development | test | production (Optional, default: development)
NODE_ENV=development
# HTTP listener port, 1-65535 (Optional, default: 3001)
PORT=3001
# Graceful shutdown drain timeout in milliseconds (Optional, default: 30000)
SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed by src/config/cors.ts (Optional in dev; recommended in production)
ALLOWED_ORIGINS=http://localhost:3000

# ── Database & Migrations ─────────────────────────────────────────────────────
# SQLite database file path (Optional, default: .data/dev.db in dev, /var/lib/quicklendx/backend.db in production)
DATABASE_PATH=.data/dev.db
# Set to "true" to permit down-migrations in non-production environments (Optional, default: false)
# ALLOW_DOWN_MIGRATIONS=false
# Express "trust proxy" setting (default: loopback).
# Accepts "loopback", a hop count (e.g. "1"), "false", or trusted proxy IPs/CIDRs.
TRUST_PROXY=loopback

# ── Stellar / Soroban RPC ─────────────────────────────────────────────────────
# Public RPC endpoint — no secret required for read-only access (Optional, default: https://soroban-testnet.stellar.org)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Comma-separated allowlist of RPC hostnames (Optional, default: soroban-testnet.stellar.org,soroban-mainnet.stellar.org,localhost)
RPC_ALLOWED_HOSTS=soroban-testnet.stellar.org,soroban-mainnet.stellar.org,localhost

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max general requests per IP per minute (Optional, default: 100)
RATE_LIMIT_POINTS=100
# Max requests per API key per minute (Optional, default: 60)
RATE_LIMIT_PER_KEY_POINTS=60
# Max reconciliation requests per minute (Optional, default: 10)
RATE_LIMIT_RECONCILIATION_POINTS=10
# Max export generation requests per minute (Optional, default: 5)
RATE_LIMIT_EXPORT_POINTS=5

# ── Exports & Archives ────────────────────────────────────────────────────────
# Maximum concurrent export jobs per API key (Optional, default: 2)
EXPORT_MAX_CONCURRENT_PER_KEY=2
# Directory where generated export files are written (Optional, default: .data/exports)
EXPORT_DIR=.data/exports
# Export download link time-to-live in milliseconds (Optional, default: 3600000 = 1 hour)
EXPORT_TTL_MS=3600000
# Directory for archived records (Optional, default: .data/archives)
ARCHIVE_DIR=.data/archives
# Enable background archiving: true | false (Optional, default: false)
ARCHIVE_ENABLED=false

# ── Risk & Exposure ───────────────────────────────────────────────────────────
# Maximum allowed exposure per investor in USD (Optional, default: 10000000000)
EXPOSURE_CAP_PER_INVESTOR_USD=10000000000

# ── Retention Policy ──────────────────────────────────────────────────────────
# Days to retain raw events before purging/archiving (Optional, default: 30)
RETENTION_RAW_EVENTS_DAYS=30
# Days to retain audit logs (Optional, default: 90)
RETENTION_AUDIT_LOG_DAYS=90
# Days to retain snapshots (Optional, default: 14)
RETENTION_SNAPSHOTS_DAYS=14
# Records processed per retention batch, 1-10000 (Optional, default: 500)
RETENTION_BATCH_SIZE=500
# Retention worker run interval in milliseconds, min 60000 (Optional, default: 86400000 = 24 hours)
RETENTION_INTERVAL_MS=86400000
# Directory for retention archive files (Optional, default: .data/retention-archives)
RETENTION_ARCHIVE_DIR=.data/retention-archives
# Actor identifier recorded in retention audit logs (Optional, default: system:retention-worker)
RETENTION_AUDIT_ACTOR=system:retention-worker

# ── Alerts & Notifications ────────────────────────────────────────────────────
# Optional JSON alert routing rules, e.g. {"routes":[{"severity":"HIGH","channels":["pagerduty","slack"]}]} (Optional)
# ALERT_ROUTES_JSON=
# Alert deduplication window in milliseconds (Optional, default: 900000 = 15 minutes)
ALERT_DEDUPE_WINDOW_MS=900000
# Maximum entries kept in notification deduplication cache (Optional, default: 10000)
MAX_NOTIFICATION_DEDUP_ENTRIES=10000
# Notification deduplication entry TTL in milliseconds (Optional, default: 86400000 = 24 hours)
NOTIFICATION_DEDUP_TTL_MS=86400000
# PagerDuty Events API v2 integration key (Optional; set via secrets manager if using PagerDuty alerts)
# PAGERDUTY_INTEGRATION_KEY=replace-with-pagerduty-integration-key
# Slack incoming webhook URL for alert notifications (Optional; set via secrets manager if using Slack alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<workspace>/<channel>/<token>
# Comma-separated email addresses for alert notifications (Optional)
# ALERT_EMAIL_RECIPIENTS=alerts@example.com

# ── Secrets (Required in production; optional in dev/test) ────────────────────
# Set via CI secrets or a secrets manager — never commit real values here.
# Admin API key, min 32 chars (Required in production)
# ADMIN_API_KEY=replace-with-at-least-32-character-admin-api-key
# Webhook HMAC verification secret, min 16 chars (Required in production)
# WEBHOOK_SECRET=replace-with-at-least-16-char-secret
# Export download link signing secret, min 32 chars (Required in production)
# EXPORT_SECRET=replace-with-at-least-32-character-export-secret
# Notification deep-link signing secret, min 32 chars (Required in production)
# NOTIFICATION_LINK_SECRET=replace-with-at-least-32-character-notification-secret
