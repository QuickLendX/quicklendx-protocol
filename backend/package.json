{
  "name": "quicklendx-backend",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "ts-node seed.ts",
    "test:seeds": "jest seeds.test.ts",
    "test": "jest",
    "test:coverage": "jest --coverage --forceExit",
    "dev": "ts-node-dev src/index.ts",
    "start": "ts-node src/index.ts",
    "security:scan": "node scripts/dependency-scan.js audit-report.json high && node scripts/secret-scan.js",
    "sbom:generate": "node scripts/generate-sbom.js sbom/backend-sbom.cdx.json",
    "sbom:check": "node scripts/validate-sbom.js sbom/backend-sbom.cdx.json",
    "migrate": "ts-node src/lib/migrations/cli.ts",
    "migrate:check": "npm run migrate -- --check",
    "migrate:dry-run": "npm run migrate -- --dry-run",
    "migrate:validate": "npm run migrate -- --validate-only",
    "migrate:up": "npm run migrate",
    "migrate:down": "ts-node src/lib/migrations/cli.ts down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/helmet": "^0.0.48",
    "@types/nodemailer": "^8.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.21.0",
    "rate-limiter-flexible": "^11.0.1",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "supertest": "^6.3.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
