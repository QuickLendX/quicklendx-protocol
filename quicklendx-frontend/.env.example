# Base URL for the QuickLendX API. Keep the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Stellar network: testnet, public, or mainnet (alias of public). Case-insensitive.
# Anything else falls back to testnet and logs a console warning.
NEXT_PUBLIC_NETWORK=testnet

# Set to 1 only by the end-to-end build; leave disabled for normal builds.
NEXT_PUBLIC_E2E=0

# Enable the new business invoice route.
NEXT_PUBLIC_ENABLE_NEW_INVOICE_ROUTE=false

# Analytics is opt-in. Supported providers: noop, mixpanel, ga, self-hosted.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=noop

# Set the relevant value when enabling its provider.
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Stellar network: testnet or public.
