{
  "name": "quicklendx-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "next": "15.5.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^4.0.12",
    "react-hot-toast": "^2.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.12",
    "jest": "^29",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29",
    "jest-environment-node": "^29",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/**/__tests__/**/*.test.ts",
          "<rootDir>/**/tests/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        }
      },
      {
        "displayName": "react",
        "preset": "ts-jest",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/**/__tests__/**/*.test.tsx",
          "<rootDir>/**/tests/**/*.test.tsx"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ]
      }
    ]
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "tar": "^7.5.8"
  }
}
