# Ensure shell scripts and CI workflows use LF so Linux/macOS runners don't see "bash\r"
*.sh text eol=lf
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf
quicklendx-contracts/src/lib.rs text working-tree-encoding=UTF-16LE text=auto
quicklendx-contracts/src/lib.rs text working-tree-encoding=UTF-16LE text=auto
quicklendx-contracts/src/lib.rs filter=utf16
