# Build outputs (all packages / nested workspaces)
target
**/target/
**/coverage/*
!**/coverage/.gitkeep
**/lcov.info

# Local diagnostics / generated logs
**/compile-errors*.log
*.profraw
*.profdata

# Contracts: build/test logs and error dumps redirected from cargo/clippy runs.
# Anchored to the package root so real sources (src/, tests/, scripts/,
# proptest-regressions/) and Cargo.lock are unaffected.
/quicklendx-contracts/*.log
/quicklendx-contracts/*.txt
/quicklendx-contracts/*.output
/quicklendx-contracts/build*.json
/quicklendx-contracts/check*.json
/quicklendx-contracts/clippy*.json
/quicklendx-contracts/coverage*.json
/quicklendx-contracts/error*.json
# rustc "type name too long" dumps (lib.long-type-<hash>.txt)
**/*.long-type-*.txt
# Stray empty file produced by a mistyped shell redirect
/quicklendx-contracts/,

# Local tool state
.omx/
.remember/

# Soroban test ledger snapshots (auto-generated by testutils, not golden files)
test_snapshots/

# Windows build artifacts (not part of the contract)
*.exe
*.pdb

CLAUDE.md
plan.md
config.bat
node_modules
